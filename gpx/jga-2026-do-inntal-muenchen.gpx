<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claude - JGA MTB Voralpen-Loop 2026" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>Do 27.08. - Inntal &amp; Mangfalltal</name>
    <desc>Do 27.08. - Inntal &amp; Mangfalltal | 113.2 km | 581 hm | Kufstein -&gt; Kiefersfelden -&gt; Oberaudorf -&gt; Neubeuern -&gt; Rosenheim -&gt; Mangfalltal -&gt; Muenchen-Sendling</desc>
    <time>2026-08-27T05:00:00Z</time>
  </metadata>
  <wpt lat="47.582530" lon="12.172280">
    <ele>491</ele>
    <name>START Hotel Andreas Hofer</name>
    <desc>[km 0.0] Abfahrt 07:00 (1 h frueher als geplant, wegen Hitze bis 30 Grad). Trinkflaschen an den Kufsteiner Brunnen fuellen. Letzter Tag mit Basti.</desc>
    <sym>Lodging</sym>
  </wpt>
  <wpt lat="47.589950" lon="12.178280">
    <ele>481</ele>
    <name>Bichlbaeck Kufstein-Sparchen</name>
    <desc>[km 1.0] Stuttgarter Str. 19. Mo-Fr ab 06:15 (bis 12:30). Tel 05372 65456. Fruehste verifizierte Option. Ca. 850 m Umweg (Ostseite des Inn). Alternative ohne Umweg: Baeckerei Ruetz, Salurner Str. 38, taeglich 7:00-18:00, Tel 05372 65259.</desc>
    <sym>Restaurant</sym>
  </wpt>
  <wpt lat="47.613840" lon="12.188780">
    <ele>486</ele>
    <name>Kiefersfelden Grenze AT/DE</name>
    <desc>[km 5.0] Grenzuebergang. Ab hier Inn-Westufer / Innauen-Schotter.</desc>
    <sym>Flag, Blue</sym>
  </wpt>
  <wpt lat="47.648560" lon="12.171990">
    <ele>483</ele>
    <name>Oberaudorf</name>
    <desc>[km 9.4] Viele Betriebe, aber keine Donnerstags-Zeiten verifiziert. Tourist-Info Kufsteiner Str. 6, Tel 08033 30120.</desc>
    <sym>Information</sym>
  </wpt>
  <wpt lat="47.773480" lon="12.138950">
    <ele>478</ele>
    <name>Neubeuern</name>
    <desc>[km 27.5] Beurer Hof hat Mi+Do Ruhetag - nicht ansteuern. Durchfahren nach Rosenheim.</desc>
    <sym>Information</sym>
  </wpt>
  <wpt lat="47.830210" lon="12.127580">
    <ele>449</ele>
    <name>Happinger Hof MITTAG</name>
    <desc>[km 36.1] Happinger Str. 23-25, Rosenheim. Taeglich 10:00-24:00, warme Kueche 11:30-21:00, Grillkueche Di-So 16:00-21:30, Biergarten. Tel +49 8031 616970. Bester verifizierter Mittagsstop, ca. km 55. Auch Wasser-Halbzeit.</desc>
    <sym>Restaurant</sym>
  </wpt>
  <wpt lat="47.901610" lon="11.839640">
    <ele>550</ele>
    <name>Mangfalltal Feldkirchen-Westerham</name>
    <desc>[km 62.6] Ab hier Mangfalltal westwaerts. Maxlmuehle ist Donnerstag GESCHLOSSEN, Alter Wirt Weyarn erst ab 16:00 - durchfahren.</desc>
    <sym>Bike Trail</sym>
  </wpt>
  <wpt lat="47.885310" lon="11.686710">
    <ele>688</ele>
    <name>Holzkirchen</name>
    <desc>[km 77.6] Letzte Versorgung vor Muenchen, falls noetig.</desc>
    <sym>Convenience Store</sym>
  </wpt>
  <wpt lat="48.035880" lon="11.574990">
    <ele>584</ele>
    <name>Kugler Alm ABSCHLUSSBIER</name>
    <desc>[km 99.6] Linienstr. 93, Oberhaching. Biergarten taeglich ab 12:00 bei Biergartenwetter, Wirtshaus Mi-So ab 12:00, Schmalznudel-Huette auch bei Regen. Tel 089 61390120. Ursprungsort des Radlers - ca. 15 km vor dem Ziel.</desc>
    <sym>Restaurant</sym>
  </wpt>
  <wpt lat="48.109270" lon="11.512450">
    <ele>545</ele>
    <name>ZIEL Muenchen-Sendling</name>
    <desc>[km 113.2] Ankunft ca. 15:00. Basti-Abschluss.</desc>
    <sym>Residence</sym>
  </wpt>
