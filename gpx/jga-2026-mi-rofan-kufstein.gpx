<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Claude - JGA MTB Voralpen-Loop 2026" xmlns="http://www.topografix.com/GPX/1/1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>Mi 26.08. - Rofan-Abfahrt &amp; Inntal</name>
    <desc>Mi 26.08. - Rofan-Abfahrt &amp; Inntal | 58.8 km | 806 hm | Berggasthof Rofan -&gt; Bayreuther Huette -&gt; Kramsach -&gt; Inntal-Radweg -&gt; Kufstein</desc>
    <time>2026-08-26T05:00:00Z</time>
  </metadata>
  <wpt lat="47.441640" lon="11.762970">
    <ele>1825</ele>
    <name>START Berggasthof Rofan</name>
    <desc>[km 0.0] Abfahrt 08:30. Erst 9,5 km / 514 hm Gegenanstieg ueber das Plateau zur Bayreuther Huette - Trail-Charakter, ggf. schieben. Alternative: mit der Seilbahn ins Tal (Talfahrt 19,50 EUR) und flach nach Kramsach.</desc>
    <sym>Lodging</sym>
  </wpt>
  <wpt lat="47.445120" lon="11.820800">
    <ele>1577</ele>
    <name>Bayreuther Huette 1576 m WASSER</name>
    <desc>[km 9.2] DAV Bayreuth. 23.05.-09.10. geoeffnet, taeglich 07:30-22:00, warme Kueche 11:30-17:30, KEIN Ruhetag. Tel +43 664 3425103. Bester Wasserstop des Tages.</desc>
    <sym>Restaurant</sym>
  </wpt>
  <wpt lat="47.447560" lon="11.873660">
    <ele>525</ele>
    <name>Kramsach Hotel Jagdhof</name>
    <desc>[km 24.8] Laend 65, Kramsach. Tel +43 5337 62287. Einziger Betrieb in Kramsach mit &#x27;kein Ruhetag&#x27; - Uhrzeiten aber unklar, anrufen. MITTWOCH ZU: Seehof Reintalersee, Landgasthof Gappen, Cafe Central.</desc>
    <sym>Restaurant</sym>
  </wpt>
  <wpt lat="47.495000" lon="12.000000">
    <ele>633</ele>
    <name>Inntal-Radweg</name>
    <desc>[km 39.1] Ab hier flach am Inn nordwaerts. Jause: Bichlbaeck Ebbs/Niederndorf - aber nur bis 13:00/14:00 offen.</desc>
    <sym>Bike Trail</sym>
  </wpt>
  <wpt lat="47.583010" lon="12.170800">
    <ele>491</ele>
    <name>Kufstein Trinkbrunnen Stadtplatz</name>
    <desc>[km 58.3] 29 oeffentliche Trinkbrunnen in Kufstein (Stadtplatz, Innpromenade, Stadtpark). Kostenlos auffuellen - auch morgen frueh vor der Abfahrt.</desc>
    <sym>Drinking Water</sym>
  </wpt>
  <wpt lat="47.582530" lon="12.172280">
    <ele>491</ele>
    <name>ZIEL Hotel Andreas Hofer</name>
    <desc>[km 58.8] Georg-Pirmoser-Str. 8, Kufstein. Tel +43 5372 6980. Abgesperrter Fahrradraum vorhanden, Bett+Bike-zertifiziert. Tiefgarage 15 EUR. Fruehstuecksbeginn NICHT publiziert - fuer Abfahrt 08:00 anrufen.</desc>
    <sym>Lodging</sym>
  </wpt>
