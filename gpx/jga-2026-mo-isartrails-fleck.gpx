  <metadata>
    <name>Mo 24.08. - Isartrails &amp; Reutberg</name>
    <desc>Mo 24.08. - Isartrails &amp; Reutberg | 97.3 km | 693 hm | Muenchen-Sendling -&gt; Isartrail Westseite -&gt; Pupplinger Au -&gt; Kloster Reutberg -&gt; Bad Toelz -&gt; Fleck</desc>
    <time>2026-08-24T05:00:00Z</time>
  </metadata>
  <wpt lat="48.109270" lon="11.512450">
    <ele>545</ele>
    <name>START Muenchen-Sendling</name>
    <desc>[km 0.0] Start/Ziel in Muenchen-Sendling. Abfahrt 07:00 - laengster Tag, kein Spielraum.</desc>
    <sym>Residence</sym>
  </wpt>
  <wpt lat="48.068500" lon="11.542700">
    <ele>532</ele>
    <name>Grosshesselohe Bruecke</name>
    <desc>[km 7.6] Isar-Uebergang, danach Westseite. Ab hier Isartrail-Charakter.</desc>
    <sym>Bridge</sym>
  </wpt>
  <wpt lat="48.056150" lon="11.523440">
    <ele>539</ele>
    <name>Baeckerei Brotzeit Pullach</name>
    <desc>[km 9.9] Kirchplatz 2, Pullach. Mo-Fr ab 07:00 (Sommerzeiten 17.08.-13.09.: bis 14:00). Tel +49 89 7930126. Einzige Baeckerei am Korridor, die um 7 aufmacht. Ca. 280 m Umweg von der Route.</desc>
    <sym>Restaurant</sym>
  </wpt>
  <wpt lat="47.978610" lon="11.467250">
    <ele>560</ele>
    <name>Kloster Schaeftlarn</name>
    <desc>[km 22.4] Klosterbraeustueberl, taeglich 10:00-22:00, Ruhetag Mittwoch, Kueche 11:30-21:00. Tel 08178 3694. Um 8 Uhr noch zu - nur als Fallback.</desc>
    <sym>Restaurant</sym>
  </wpt>
  <wpt lat="47.898320" lon="11.450490">
    <ele>584</ele>
    <name>Pupplinger Au Badestelle</name>
    <desc>[km 36.4] Isar-Schwimmpause. Naturschutzgebiet: nur bestehende Zugaenge, Kiesinseln meiden (Vogelschutz), Feuer/Rauchen verboten.</desc>
    <sym>Swimming Area</sym>
  </wpt>
  <wpt lat="47.813530" lon="11.637130">
    <ele>720</ele>
    <name>Kloster Reutberg</name>
    <desc>[km 71.3] Braeustueberl mit Blick auf die Benediktenwand. Oeffnungszeiten nicht verifiziert - vorher pruefen.</desc>
    <sym>Restaurant</sym>
  </wpt>
  <wpt lat="47.761300" lon="11.558930">
    <ele>655</ele>
    <name>Bad Toelz Kolberbraeu MITTAG</name>
    <desc>[km 81.9] Posthotel Kolberbraeu, Marktstr. 29. Kein Ruhetag, warme Kueche 11:00-21:00 durchgehend. Tel +49 8041 7688-0. Montagssicher. Alternativ Baeckerei Buettner, Marktstr. 50, Mo-Fr 6:45-18:00.</desc>
    <sym>Restaurant</sym>
  </wpt>
  <wpt lat="47.683160" lon="11.576400">
    <ele>678</ele>
    <name>Lenggries</name>
    <desc>[km 92.9] Letzte Einkaufsmoeglichkeit vor Fleck. Kurze Pause.</desc>
    <sym>Convenience Store</sym>
  </wpt>
  <wpt lat="47.651410" lon="11.589200">
    <ele>692</ele>
    <name>ZIEL Landgasthof zum Papyrer</name>
    <desc>[km 97.3] Fleck 5, 83661 Lenggries-Hohenreuth. Tel 08042 5633077. ACHTUNG: Quellen widersprechen sich zum Ruhetag Montag - VORHER ANRUFEN. Fruehstueck 08:00-09:30 zubuchbar. Kueche Mai-Sept 11:00-22:00, warm bis 21:00.</desc>
    <sym>Lodging</sym>
  </wpt>
